# Node >= 22.16 (node:sqlite online backup). Copy to .env.local for development only.
# Production secrets belong in the service environment, never in Git.
MEMBERS_AUTH_URL=https://yandoubuy.cn
MEMBERS_AUTH_SECRET=
# Absolute persistent file OUTSIDE the checkout/release directory.
MEMBERS_DB_PATH=/var/lib/yandoubuy-members/members.sqlite
# disabled until account, domain and FREE plan are confirmed.
MEMBERS_EMAIL_MODE=disabled
MEMBERS_RESEND_API_KEY=
MEMBERS_EMAIL_FROM=
# Private backup tool only; use a separate random key, preserve outside backups.
# MEMBERS_BACKUP_KEY=
# Enable only when the reverse proxy overwrites x-real-ip; never trust incoming user headers.
MEMBERS_TRUST_PROXY=false
# Admin dashboard currently unlocks with password only. Retained MFA is opt-in.
MEMBERS_ADMIN_MFA_ENABLED=false
# Local-only isolated test mode: NODE_ENV != production and loopback auth URL required.
# MEMBERS_EMAIL_MODE=test
# MEMBERS_TEST_MAIL_DIR=<absolute path outside checkout>
